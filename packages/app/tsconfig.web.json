{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "//": "src/preload/*.d.ts is what declares window.embroider for the renderer.",
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/*.d.ts"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
