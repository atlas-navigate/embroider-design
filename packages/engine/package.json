{
  "name": "@embroider-design/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript embroidery design engine: geometry, stitch generation, lettering, auto-digitizing, and embroidery file format I/O.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "goldens:update": "node scripts/update-goldens.mjs"
  },
  "dependencies": {
    "image-q": "^4.0.0",
    "opentype.js": "^1.3.4",
    "polygon-clipping": "^0.15.7",
    "simplify-js": "^1.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/opentype.js": "^1.3.8",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
